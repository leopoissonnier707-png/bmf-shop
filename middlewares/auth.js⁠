const { Client } = require('discord.js');
// Supposons que tu as exporté ton instance de client Discord
const client = require('../bot'); 
const GUILD_ID = process.env.DISCORD_GUILD_ID;

// Middleware pour vérifier si l'utilisateur est banni du serveur
async function checkNotBanned(req, res, next) {
  if (!req.user) return res.status(401).json({ error: 'Non authentifié' });
  
  try {
    const guild = await client.guilds.fetch(GUILD_ID);
    const bans = await guild.bans.fetch();
    const isBanned = bans.has(req.user.discordId);

    if (isBanned) {
      // Destruction de la session si l'utilisateur est banni
      req.logout(() => {});
      return res.status(403).json({ error: 'Accès refusé : vous êtes banni du serveur Discord.' });
    }
    next();
  } catch (err) {
    console.error('Erreur lors de la vérification du bannissement:', err);
    res.status(500).json({ error: 'Erreur serveur lors de la vérification de sécurité' });
  }
}

// Middleware pour vérifier une permission spécifique
function requirePermission(permissionKey) {
  return async (req, res, next) => {
    // req.userPermissions contient le tableau de toutes les permissions cumulées de ses rôles
    if (!req.userPermissions || !req.userPermissions.includes(permissionKey)) {
      return res.status(403).json({ error: `Permission insuffisante : ${permissionKey}` });
    }
    next();
  };
}

module.exports = { checkNotBanned, requirePermission };
